{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: clang++ 활성 파일 빌드",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-c",
                "/usr/bin/clang++ -std=c++17 -g '${file}' -o '${fileDirname}/${fileBasenameNoExtension}' && '${fileDirname}/${fileBasenameNoExtension}'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
